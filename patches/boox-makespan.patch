+    std::pair<sInt_32, sInt_32> sSMTCBS::find_ShortestMakespanNonconflictingRotationInverseDepleted(sSolution &solution, sInt_32 makespan_limit) const
+    {
+	return find_ShortestMakespanNonconflictingRotation(solution, makespan_limit, false);
+    }
+
+
+    std::pair<sInt_32, sInt_32> sSMTCBS::find_ShortestMakespanNonconflictingRotationInverseOmitted(sSolution &solution, sInt_32 makespan_limit) const
+    {
+	return find_ShortestMakespanNonconflictingRotation(solution, makespan_limit, true);
+    }
+
+
+    std::pair<sInt_32, sInt_32> sSMTCBS::find_ShortestMakespanNonconflictingRotation(sSolution &solution, sInt_32 makespan_limit, bool omitted) const
+    {
+	sDouble start_time = sStatistics::get_CPU_Seconds();
+	sInt_32 N_agents = m_Instance->m_start_configuration.get_AgentCount();
+	// MPF stores no goal entries for trailing unassigned agent IDs.
+	sInt_32 undefined_location = sConfiguration::UNDEFINED_LOCATION;
+	m_Instance->m_goal_configuration.m_agent_Locs.resize(N_agents + 1, undefined_location);
+	sInstance::VertexIDs_vector sources, goals;
+	m_Instance->collect_Endpoints(sources, goals);
+	m_Instance->m_environment.calc_SourceGoalShortestPaths(sources, goals);
+	const sUndirectedGraph::Distances_2d_vector &distances = m_Instance->m_environment.get_SourceShortestPaths();
+	sInt_32 lower_bound = 0;
+	for (sInt_32 i = 0; i < N_agents; ++i)
+	{
+	    if (goals[i] >= 0)
+	    {
+		lower_bound = sMAX(lower_bound, distances[sources[i]][goals[i]]);
+	    }
+	}
+	AgentPaths_vector agent_Paths;
+	Context context;
+
+	for (sInt_32 makespan = lower_bound; makespan <= makespan_limit; ++makespan)
+	{
+	    sInstance::MDD_vector MDD, extra_MDD;
+	    sInstance::InverseMDD_vector inverse_MDD;
+	    m_Instance->construct_MakespanRotationMDD(makespan, MDD, extra_MDD);
+	    m_Instance->construct_InverseMDD(MDD, inverse_MDD);
+
+	    if (m_timeout >= 0 && sStatistics::get_CPU_Seconds() - start_time >= m_timeout)
+	    {
+		return std::pair<sInt_32, sInt_32>(-2, -2);
+	    }
+	    // Empty extra_MDD disables the FUEL+/total-cost cardinality constraint.
+	    std::pair<sInt_32, sInt_32> result = omitted
+		? find_NonconflictingRotation_GlucoseCollisionsInverseOmitted(*m_Instance, context, MDD, extra_MDD, inverse_MDD, 0, agent_Paths, makespan)
+		: find_NonconflictingRotation_GlucoseCollisionsInverseDepleted(*m_Instance, context, MDD, extra_MDD, inverse_MDD, 0, agent_Paths, makespan);
+	    if (result.first >= 0)
+	    {
+		sInt_32 N_agents = m_Instance->m_start_configuration.get_AgentCount();
+		for (sInt_32 agent_id = 1; agent_id <= N_agents; ++agent_id)
+		{
+		    for (sInt_32 i = 1; i < agent_Paths[agent_id].size(); ++i)
+		    {
+			if (agent_Paths[agent_id][i - 1] != agent_Paths[agent_id][i])
+			{
+			    solution.add_Move(i - 1, sSolution::Move(agent_id, agent_Paths[agent_id][i - 1], agent_Paths[agent_id][i]));
+			}
+		    }
+		}
+		return std::pair<sInt_32, sInt_32>(makespan, result.second);
+	    }
+	    if (result.first == -2)
+	    {
+		return result;
+	    }
+	    if (m_timeout >= 0 && sStatistics::get_CPU_Seconds() - start_time > m_timeout)
+	    {
+		return std::pair<sInt_32, sInt_32>(-2, -2);
+	    }
+	}
+	return std::pair<sInt_32, sInt_32>(-1, -1);
+    }
     
 
